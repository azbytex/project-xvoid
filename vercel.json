{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/((?!api/|web/).*)",
      "destination": "/web/$1"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "web/**"
    }
  }
}
